# URL du déploiement Convex (renseignée après avoir exécuté `npx convex dev`)
PUBLIC_CONVEX_URL=https://outgoing-octopus-902.eu-west-1.convex.cloud

# Cible CLI Convex (nom ou URL du déploiement)
CONVEX_DEPLOYMENT=https://outgoing-octopus-902.eu-west-1.convex.cloud

# Clé de déploiement Convex (dashboard → Settings → Deployment keys)
# ATTENTION : ne jamais committer cette valeur.
CONVEX_DEPLOY_KEY=

# URL des actions HTTP Convex (site URL), utile pour l'authentification
CONVEX_SITE_URL=https://outgoing-octopus-902.eu-west-1.convex.site

# Carte des zones de prospection (page /zones)
# Token Mapbox : https://account.mapbox.com/access-tokens
PUBLIC_MAPBOX_TOKEN=

# Bilan de prospection (page /bilan) : données importées depuis l'app mobile
# BeastDoor. L'endpoint public ci-dessous renvoie toutes les portes/visites
# sans clé ; le device filtré est celui de la tablette de Pierre Torres.
# À ajuster si le déploiement BeastDoor ou la tablette changent.
BEASTDOOR_SYNC_URL=https://gallant-marlin-237.eu-west-1.convex.site/beastdoor/sync
BEASTDOOR_DEVICE_PIERRE=tablet-b70f3fcd-f5de-4487-bddf-59a4f3ed0759
